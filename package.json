{
  "name": "orderlens",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first analytics for your Amazon order history export. Runs entirely in the browser.",
  "license": "MIT",
  "keywords": [
    "amazon",
    "order-history",
    "analytics",
    "gdpr-export",
    "privacy",
    "react",
    "dashboard"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=orderlens --branch=main --commit-dirty=true",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.33.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  },
  "homepage": "https://orderlens.moinsen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moinsen-dev/orderlens.git"
  },
  "bugs": {
    "url": "https://github.com/moinsen-dev/orderlens/issues"
  },
  "author": "Ulrich Diedrichsen"
}
